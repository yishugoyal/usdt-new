# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Auth & Encryption Secrets
AUTH_SECRET="your-32-byte-secret-key-here"
ENCRYPTION_KEY="your-32-byte-encryption-key-here"

# Production Readiness Engine & Mode
NODE_ENV="development"
ENABLE_SANDBOX_PROVIDERS="true"
PRODUCTION_GATE_APPROVED="false"

# Platform Fees & Limits Configuration
DEFAULT_SPREAD_PERCENTAGE="0.5"
DEFAULT_COMPANY_FEE_PERCENTAGE="0.25"
MIN_SELL_USDT="50"
MAX_SELL_USDT="100000"
QUOTE_EXPIRY_SECONDS="300"

# External Provider Credentials
RATE_PROVIDER_API_KEY=""
CUSTODY_PROVIDER_API_KEY=""
CUSTODY_WEBHOOK_SECRET=""
BLOCKCHAIN_PROVIDER_API_KEY=""
PAYOUT_PROVIDER_API_KEY=""
PAYOUT_WEBHOOK_SECRET=""
COMPLIANCE_PROVIDER_API_KEY=""

# Email Configuration (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@rupeebridge.in"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
